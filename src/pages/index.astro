---
import Layout from '../layouts/Layout.astro';
import posts from '../generated/posts.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/`, Astro.site).href;
const description = '60年代ロックやパワーポップなどの音楽、バンド活動、情報科学、プログラミングについて書いている個人ブログです。';
---
<Layout title="Kawanabe Notion Blog" description={description} canonical={canonical}>
  <h1>Kawanabe Notion Blog</h1>
  <p class="muted">音楽、情報科学、プログラミングなどについて書いています。</p>
  <h2>記事一覧</h2>
  {posts.length === 0 ? <p>公開中の記事はまだありません。</p> : <ol class="post-list">
    {posts.map((post) => <li>
      <time datetime={post.date}>{post.date.replaceAll('-', '/')}</time>
      <h2><a href={`${base}/posts/${post.id}/`}>{post.title}</a></h2>
      <p>{post.excerpt}</p>
      {post.tags.length > 0 && <ul class="tags">{post.tags.map((tag) => <li>{tag}</li>)}</ul>}
    </li>)}
  </ol>}
</Layout>
